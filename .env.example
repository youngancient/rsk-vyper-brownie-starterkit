# .env.example
# DO NOT commit your actual .env file to GitHub!

# Ape Framework securely handles Private Keys natively using its encrypted Keystore.
# DO NOT put raw private keys into your .env files!
# WARNING: Public nodes have rate limits! Use dedicated RPCs (like Alchemy) for production scale.
# Override default public RPCs using Ape Framework's native environment variables:
APE_ROOTSTOCK_TESTNET_URI=https://public-node.testnet.rsk.co
APE_ROOTSTOCK_MAINNET_URI=https://public-node.rsk.co

# Required for contract verification on Blockscout
BLOCKSCOUT_API_KEY=your_blockscout_api_key_here